/* ---- Configuration ---- */
configuration {
    modi:                       "drun,run";
    font:                       "JetBrainsMono Nerd Font 11";
    show-icons:                 false;
    display-drun:               "APPS";
    display-run:                "RUN";
    hover-select:               false;
    scroll-method:              1;
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

/* ---- Global Colors (ML4W Palette) ---- */
* {
    background:                  rgba(30, 30, 46, 0.9);
    foreground:                  #FFFFFF;
    border-color:                #cba6f7;
    selected:                    #cba6f7;
    border-width:                2px;
}

/* ---- Window ---- */
window {
    width:                        600px;
    x-offset:                     0px;
    y-offset:                     0px;
    spacing:                      0px;
    padding:                      0px;
    margin:                       0px;
    color:                        #FFFFFF;
    border:                       @border-width;
    border-radius:                12px;
    background-color:             @background;
    location:                     center;
    anchor:                       center;
}

/* ---- Mainbox ---- */
mainbox {
    enabled:                      true;
    orientation:                  vertical;
    spacing:                      0px;
    margin:                       0px;
    background-color:             transparent;
    children:                     ["inputbar", "listview"];
}

/* ---- Inputbar ---- */
inputbar {
    enabled:                      true;
    text-color:                   @foreground;
    spacing:                      10px;
    padding:                      15px;
    background-color:             rgba(255, 255, 255, 0.05);
    children:                     ["entry"];
}

entry {
    enabled:                      true;
    background-color:             transparent;
    text-color:                   inherit;
    cursor:                       text;
    placeholder:                  "Search Applications...";
    placeholder-color:            inherit;
}

/* ---- Listview ---- */
listview {
    enabled:                      true;
    columns:                      1;
    lines:                        8;
    cycle:                        false;
    scrollbar:                    false;
    layout:                       vertical;
    fixed-height:                 true;
    spacing:                      5px;
    padding:                      10px;
    background-color:             transparent;
    border:                       0px;
}

/* ---- Element ---- */
element {
    enabled:                      true;
    padding:                      8px;
    margin:                       2px;
    cursor:                       pointer;
    background-color:             transparent;
    border-radius:                8px;
}

element normal.normal,
element alternate.normal {
    background-color:             transparent;
    text-color:                   @foreground;
}

element selected.normal {
    background-color:             @selected;
    text-color:                   #11111b;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
