{
    "layer": "top",
    "position": "bottom",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,

    "include": [
        "~/.config/waybar/modules/*.jsonc",
        "~/.config/waybar/modules/custom/*.jsonc",
        "~/.config/waybar/modules/extra/*.jsonc",
        "~/.config/waybar/modules/hyprland/*.jsonc"
    ],

    "modules-right": [
        "tray",
        "bluetooth",
        "network",
        "pulseaudio",
        "clock"
    ],

    "modules-center": [
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-left": [
        "custom/power_btn",
        "custom/restart",
        "custom/logout"
    ],

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "locale": "tr_TR.UTF-8",
        "on-click": "pkill -x calcurse || calcurse"
    },

    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format": "{essid}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "on-click": "pkill -x systemsettings || systemsettings kcm_networkmanagement"
    },

    "bluetooth": {
        "on-click": "pkill -x systemsettings || systemsettings kcm_bluetooth"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pkill -x pavucontrol || pavucontrol"
    },



    "custom/logout": {
        "format": "󰗽",
        "tooltip": false,
        "on-click": "hyprctl dispatch exit"
    },

    "custom/restart": {
        "format": "󰜉",
        "tooltip": false,
        "on-click": "loginctl reboot"
    },

    "custom/power_btn": {
        "format": "",
        "tooltip": false,
        "on-click": "loginctl poweroff"
    },


    "tray": {
    "icon-size": 18,
    "spacing": 12
    },

    "hyprland/window": {
        "format": " {}",
        "max-length": 40
    }
}
