{
  "workbench.colorCustomizations": {
    // Genel Arkaplan ve Kenarlıklar (AMOLED Siyah)
    "editor.background": "#000000",
    "sideBar.background": "#000000",
    "sideBar.border": "#54487A",
    "activityBar.background": "#000000",
    "activityBar.border": "#54487A",
    "titleBar.activeBackground": "#000000",
    "titleBar.inactiveBackground": "#000000",
    "window.activeBorder": "#54487A",

    // Yazı ve İkon Renkleri (Gentoo Moru)
    "foreground": "#54487A",
    "editor.foreground": "#54487A",
    "sideBar.foreground": "#54487A",
    "activityBar.foreground": "#54487A",
    "activityBar.inactiveForeground": "#444444", // Pasif ikonlar için koyu gri
    "breadcrumb.foreground": "#54487A",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionForeground": "#54487A",

    // Butonlar ve Kontroller
    "button.background": "#54487A",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#6E56AF", // Hover rengi

    // Listeler ve Menüler (Hover Efektleri)
    "list.hoverBackground": "#6E56AF33", // Hafif şeffaf hover
    "list.hoverForeground": "#6E56AF",
    "list.activeSelectionBackground": "#54487A80",
    "menu.selectionForeground": "#6E56AF",
    "menu.selectionBackground": "#000000",

    // Sekmeler (Tabs)
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#6E56AF",
    "tab.activeBorder": "#6E56AF",
    "tab.inactiveBackground": "#000000",
    "tab.inactiveForeground": "#54487A",
    "tab.hoverBackground": "#000000",
    "tab.hoverForeground": "#6E56AF",

    // Durum Çubuğu (Status Bar)
    "statusBar.background": "#000000",
    "statusBar.foreground": "#54487A",
    "statusBar.border": "#54487A",
    "statusBarItem.hoverBackground": "#6E56AF33"
  },
  
  // Kod Renkleri (Syntax)
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "keyword",
          "storage.type",
          "storage.modifier",
          "punctuation",
          "variable",
          "entity.name.function"
        ],
        "settings": {
          "foreground": "#54487A"
        }
      },
      {
        "scope": "comment",
        "settings": {
          "foreground": "#444444",
          "fontStyle": "italic"
        }
      }
    ]
  }
}