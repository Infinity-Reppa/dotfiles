font_family      JetBrainsMono Nerd Medium
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        11.0

term xterm-kitty
linux_display_server wayland
map ctrl+c copy_or_interrupt
map ctrl+v paste_from_clipboard
shell /usr/bin/fish

cursor           #54487A
cursor_text_color #ffffff
cursor_shape     beam

background #000000
foreground #e0e0e0
selection_background #54487A
selection_foreground #ffffff
url_color #d6acff
background_opacity 0.85

disable_ligatures never


color0 #1a1a1a
color8 #444444
color1 #ff5555
color9 #ff6e67
color2 #a020f0
color10 #b266ff
color3 #bd93f9
color11 #d6acff
color4 #54487A
color12 #7a6eb3
color5  #54487A
color13 #7a6eb3
color6 #d1b1fc
color14 #e2d1fc
color7 #f8f8f2
color15 #ffffff



# BEGIN_KITTY_FONTS
font_family      family="FiraCode Nerd Font Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS
